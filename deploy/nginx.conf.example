# Nginx 部署配置模板 — 宇宙无敌表达训练 WebUI
# 复制到 /etc/nginx/conf.d/expression-trainer.conf（或 nginx.conf 内 server 块）后 nginx -s reload
# 注意：把 <your-domain-or-ip> 换成实际域名/IP；按需调整 ssl 部分

server {
    # 对外监听（80 http；生产建议 443 https + 证书）
    listen 80;
    server_name <your-domain-or-ip>;

    # 前端静态资源（打包产物 public/ 直接给 Nginx 管，不用 Node 发）
    # 部署时把项目 public/ 目录拷到该路径（或软链）
    root /opt/expression-trainer/public;
    index index.html;

    # 防止缓存 index.html 旧版本（前端更新后强刷生效）
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri /index.html;
    }

    # SPA 兜底：非文件请求回 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API 反代 → Node（127.0.0.1:3210，与 package.json 启动的服务一致）
    location /api/ {
        proxy_pass http://127.0.0.1:3210;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # WebSocket（音频流 + ASR 结果）反代 → Node
    location /ws {
        proxy_pass http://127.0.0.1:3210;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;   # 长会话
        proxy_send_timeout 3600s;
    }

    # 静态资源缓存（js/css/fonts 等带 hash 或无 hash 的资源，开发期可关）
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|woff2?)$ {
        expires 1d;
        add_header Cache-Control "public";
    }

    # gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1k;
}